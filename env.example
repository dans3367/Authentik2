# Database Configuration
# Database type: 'postgres' (default) or 'neon'
DB_TYPE=postgres

# Database URL - required for both database types
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# SSL Configuration for standard PostgreSQL
# Set to 'true' if your PostgreSQL server requires SSL
# Default is 'false' (non-SSL) for local development
DB_SSL=false

# JWT Secret - required for authentication
JWT_SECRET=your_jwt_secret_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Configuration
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Server Configuration
PORT=3501
NODE_ENV=development

# External Access Configuration
# Set this to your IP address when accessing from external network
# Example: BASE_URL=http://192.168.1.100:3501
BASE_URL=http://localhost:3501

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests with credentials
# NEVER use * (wildcard) in production - it will be ignored for security
# Example: CORS_ORIGIN=http://192.168.1.100:5173,https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Optional: AWS S3 Configuration for file uploads
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=us-east-1

# Optional: Amazon SES Backup Email Provider
AWS_SES_ACCESS_KEY_ID=your_ses_access_key
AWS_SES_SECRET_ACCESS_KEY=your_ses_secret_key
AWS_SES_REGION=us-east-1
AWS_SES_CONFIGURATION_SET=newsletter-tracking

# Optional: Redis Configuration for session storage
REDIS_URL=redis://localhost:6379

# Trigger.dev Configuration (for background task processing)
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key
TRIGGER_PROJECT_ID=proj_your_project_id

# Internal Service Authentication (for secure internal API calls)
# Generate a secure random string: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here

# Convex Configuration (for real-time newsletter tracking)
CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ClickHouse (houseclickDB) — activity log analytics
CLICKHOUSE_URL=http://your-clickhouse-host:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password

# Google Sign-In Configuration (for email signup forms)
# Get your Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Unsplash API Configuration (for birthday card image search)
VITE_ACCESS_KEY=your_unsplash_access_key_here
VITE_SECRET_KEY=your_unsplash_secret_key_here

